# Environment variables for local development.
# Copy to .env and uncomment only what you need. Never put real secrets or
# production values in this file. See the Authentication section of README.md.
#
# Locally the defaults let the service start without these, but sign-in
# can't complete without a real App Registration.

# Microsoft Entra ID tenant (directory) ID. Required in production.
# ENTRA_TENANT_ID=

# Application (client) ID of the App Registration shared with the backend.
# Required in production.
# ENTRA_CLIENT_ID=

# API scope exposed by the App Registration. Defaults to access_as_user.
# ENTRA_API_SCOPE=

# Public address of this service. Defaults to http://localhost:3000 locally;
# required, and must use https://, in production.
# APP_BASE_URL=

# form_post or query. Defaults to query locally and form_post in production.
# ENTRA_RESPONSE_MODE=

# web-identity or mock. Defaults to mock locally; production refuses mock.
# ENTRA_TOKEN_PROVIDER=

# Audience of the AWS STS token. Defaults to api://AzureADTokenExchange.
# ENTRA_FEDERATED_CREDENTIAL_AUDIENCE=

# Sign-in state cookie settings. Default to false and Lax locally;
# production refuses ENTRA_STATE_COOKIE_SECURE=false.
# ENTRA_STATE_COOKIE_SECURE=
# ENTRA_STATE_COOKIE_SAME_SITE=

# Encrypts the session, sign-in and sign-in state cookies. At least 32
# characters. A development-only default is used locally; required in
# production.
# SESSION_COOKIE_PASSWORD=

# Only send the session and sign-in cookies over HTTPS. Defaults to false
# locally; production refuses false.
# SESSION_COOKIE_SECURE=

# How long the session and sign-in cookies last after the last request, and
# how long a session is kept in the session cache, in milliseconds.
# Both default to 4 hours.
# SESSION_COOKIE_TTL=
# SESSION_CACHE_TTL=

# Local development only: sign in as a fake developer, so you can see pages
# before the Entra ID App Registration exists. It defaults to false. The
# service refuses to start if it is true and ENVIRONMENT is not exactly local,
# or NODE_ENV is production. Only the exact text true turns it on. Never set
# it anywhere but your own machine.
# To use it, set ENVIRONMENT=local and LOCAL_SIGN_IN=true.
# ENVIRONMENT=
# LOCAL_SIGN_IN=false
# The fake developer's role: Administrator, DataSteward or DataOwner.
# LOCAL_SIGN_IN_ROLE=Administrator
